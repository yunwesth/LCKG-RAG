# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7688
NEO4J_BOLT_PORT=7688
NEO4J_HTTP_PORT=7475
NEO4J_DATABASE=neo4j
# Admin: used only by ingest (writes) and the Docker bootstrap.
NEO4J_ADMIN_USER=neo4j
NEO4J_ADMIN_PASSWORD=change-me-admin
# App: used by the orchestrator/tools. Treated as read-only (see docs/masterplan.md section 11).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-admin
# Where the Neo4j data lives on the host (default is a project-local folder).
NEO4J_DATA_DIR=./neo4j/data
NEO4J_QUERY_TIMEOUT_S=15
NEO4J_RESULT_LIMIT=500

# --- Ollama (runs on the host, not in Docker) ---
OLLAMA_BASE_URL=http://localhost:11434
# Models are config, never hardcoded. Exact chat tag is verified with `ollama pull`.
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=3

# --- Ingest (Phase 2) ---
INGEST_BATCH_SIZE=64
INGEST_MAX_CHARS=2000

# --- Orchestrator (Phase 4) ---
MAX_TOOL_STEPS=4
TOTAL_TIMEOUT_S=120

# --- Langfuse (Phase 5) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
