# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7688
NEO4J_BOLT_PORT=7688
NEO4J_HTTP_PORT=7475
NEO4J_DATABASE=neo4j
# Admin: used only by ingest (writes) and the Docker bootstrap.
NEO4J_ADMIN_USER=neo4j
NEO4J_ADMIN_PASSWORD=change-me-admin
# App: used by the orchestrator/tools. Treated as read-only (see docs/masterplan.md section 11).
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-admin
# Where the Neo4j data lives on the host (default is a project-local folder).
NEO4J_DATA_DIR=./neo4j/data
NEO4J_QUERY_TIMEOUT_S=15
NEO4J_RESULT_LIMIT=500

# --- Ollama (runs on the host, not in Docker) ---
OLLAMA_BASE_URL=http://localhost:11434
# Models are config, never hardcoded. Exact chat tag is verified with `ollama pull`.
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_S=60
OLLAMA_MAX_RETRIES=3
# Leave empty for the model default. false turns reasoning off (much faster); evals show the quality effect.
OLLAMA_THINK=

# --- Ingest (Phase 2) ---
INGEST_BATCH_SIZE=64
INGEST_MAX_CHARS=2000

# --- Orchestrator (Phase 4) ---
MAX_TOOL_STEPS=4
TOTAL_TIMEOUT_S=120
# HTTP API. Binding to a non-loopback host requires ORCH_API_KEY (clients send it as a Bearer token).
ORCH_HOST=127.0.0.1
ORCH_PORT=8000
ORCH_API_KEY=
ORCH_MAX_MESSAGES=50
ORCH_MAX_CHARS=20000
ORCH_MAX_CONCURRENT=2
ORCH_QUEUE_WAIT_S=30
ORCH_KEEPALIVE_S=10

# --- Langfuse tracing (Phase 5). Leave HOST/KEYS empty = tracing off. ---
# Start the local server: docker compose -f docker-compose.langfuse.yml up -d   (UI http://localhost:3100)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# false = record sizes/timings only, never question or answer text
LANGFUSE_CAPTURE_CONTENT=true
# Server-side secrets for docker-compose.langfuse.yml (generate each with: openssl rand -hex 16; ENCRYPTION_KEY: openssl rand -hex 32)
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_PASSWORD=
